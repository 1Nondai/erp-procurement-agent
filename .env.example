# ============================================================
# 明远实验装备 · ERP 采购智能助手 —— 环境变量模板
# ------------------------------------------------------------
# 用法：cp .env.example .env，然后只改前两段（密钥 / 数据库）。
# 安全约定：
#   1. .env 已进 .gitignore，禁止提交；
#   2. 所有敏感配置只从 src/agent/env_utils.py 读取，
#      不要在别的文件里直接 os.getenv 绕过统一入口；
#   3. 若密钥曾出现在任何分享过的代码里，请立即去服务商控制台轮换。
# ============================================================

# ---- LLM 服务（必填）----
# DeepSeek：主 Agent / 摘要模型 / RAG 答案生成
DEEPSEEK_API_KEY=sk-你的DeepSeek密钥
DEEPSEEK_BASE_URL=https://api.deepseek.cn/v1

# 智谱：web_search 工具 + RAG embedding（embedding-3）
ZHIPU_API_KEY=你的智谱API密钥

# ---- 数据库（必填）----
# 本地开发默认 postgres/postgres（与 docker-compose 一致）；
# 生产环境务必改密码，并同步设置 docker-compose 用的 POSTGRES_PASSWORD。
#
# 同一个库承载两类数据，靠 schema 隔离：
#   erp.*        业务数据（供应商/物料/报价/订单/库存），由 db/init/*.sql 建好
#   默认 schema  LangGraph checkpoint / store / 展示消息，由代码 setup() 建表
POSTGRES_URI=postgresql://postgres:postgres@localhost:5432/langgraph_db

# 业务库连接串（可选）。不填则复用 POSTGRES_URI。
# 生产环境常见做法：MCP Server 用只读账号 + 一个独立的写入账号。
# ERP_DB_URI=postgresql://erp_reader:******@db-internal:5432/lihuankang

# ---- RAG 知识库（可选，默认值即可）----
# 向量库落盘目录（JSONL + numpy，不是 Chroma；目录名是历史遗留）
# RAG_CHROMA_DIR=
# embedding 模型名（默认 embedding-3）
# RAG_EMBEDDING_MODEL=embedding-3
# 检索 top-k（默认 5）
# RAG_TOP_K=5

# ---- 服务配置（可选）----
# CORS 额外允许的前端来源（逗号分隔）
# CORS_EXTRA_ORIGINS=http://localhost:5173
# OpenSandbox 地址。默认 8080，与很多本机服务撞端口，冲突时改这里
# SANDBOX_DOMAIN=http://127.0.0.1:8080

# ---- MCP Server（可选）----
# 业务 MCP（供应商/物料/订单/库存工具）；默认指向本地 8000 端口的 /mcp
# ERP_MCP_URL=http://127.0.0.1:8000/mcp
# ERP_MCP_SERVER_NAME=erp-api
# 图表/可视化 MCP Server 的完整 URL（如自建的 streamable_http 端点）。
# 留空 = 不启用图表 MCP：Agent 正常启动，只是没有图表工具。
# 不要把带个人应用 ID 的第三方托管地址写进仓库。
# CHART_MCP_URL=
# 该 server 在连接配置中的名字（默认 chart，仅用于日志与分组）
# CHART_MCP_SERVER_NAME=chart

# ---- 调试（可选）----
# 流式调试日志：0=关闭（默认） 1=记录 TOKEN/TOOL 级事件 2=额外记录每 token 的 RAW_CHUNK
# DEBUG_STREAM=0
# 子 Agent 工具名严格校验（1=启动即报错，0=放行）
# SUBAGENT_TOOL_STRICT=1
# 沙箱出网策略（allowlist=白名单默认拒绝，open=全放开仅排障用）
# SANDBOX_EGRESS_MODE=allowlist
# 出网策略构造失败时的降级开关：默认 fail-closed（策略不可用则沙箱启动失败）。
# 仅本地排障、明确接受"沙箱可访问任意公网/内网"风险时才设为 1。
# SANDBOX_EGRESS_FAIL_OPEN=0
# 订单写操作幂等库（默认 src/mcp_server/.state/idempotency.sqlite3）
# IDEMPOTENCY_DB_PATH=
# 幂等去重时间窗（秒，默认 24 小时）
# IDEMPOTENCY_TTL_SECONDS=86400
