# ============================================================
# QingchiERP 环境变量配置（复制为 .env 后填写真实值）
# ------------------------------------------------------------
# 安全提醒：
#   1. .env 文件禁止提交到 Git（应加入 .gitignore）；
#   2. 此前项目里曾明文硬编码过 API Key——若该 Key 已泄漏到任何
#      分享过的代码里，请立即在服务商控制台轮换；
#   3. 所有敏感配置统一由 src/agent/env_utils.py 读取，不要在
#      其他文件里直接 os.getenv 绕过统一入口。
# ============================================================

# ---- LLM 服务（必填）----
# DeepSeek：主模型 / 摘要模型 / RAG 答案生成
DEEPSEEK_API_KEY=sk-你的DeepSeek密钥
DEEPSEEK_BASE_URL=https://api.deepseek.cn/v1

# 智谱：web_search 工具 + RAG embedding（embedding-3）
ZHIPU_API_KEY=你的智谱API密钥

# ---- 数据库（必填）----
# PostgreSQL：LangGraph checkpoint + 展示消息表
# 本地开发默认 postgres/postgres（与 docker-compose 一致）；
# 生产环境务必改密码，并同步设置 docker-compose 用的 POSTGRES_PASSWORD
POSTGRES_URI=postgresql://postgres:postgres@localhost:5432/langgraph_db

# ---- RAG 知识库（可选，默认值即可）----
# 向量库落盘目录
# RAG_CHROMA_DIR=
# embedding 模型名（默认 embedding-3）
# RAG_EMBEDDING_MODEL=embedding-3
# 检索 top-k（默认 5）
# RAG_TOP_K=5

# ---- 服务配置（可选）----
# CORS 额外允许的前端来源（逗号分隔）
# CORS_EXTRA_ORIGINS=http://localhost:5173

# ---- MCP Server（可选）----
# 业务 MCP（订单/供应商/零部件工具）；默认指向本地 8000 端口的 /mcp
# ERP_MCP_URL=http://127.0.0.1:8000/mcp
# ERP_MCP_SERVER_NAME=erp-api
# 图表/可视化 MCP Server 的完整 URL（如自建的 streamable_http 端点）。
# 留空 = 不启用图表 MCP：Agent 正常启动，只是没有图表工具。
# 不要把带个人应用 ID 的第三方托管地址写进仓库。
# CHART_MCP_URL=
# 该 server 在连接配置中的名字（默认 chart，仅用于日志与分组，任意唯一名即可）
# CHART_MCP_SERVER_NAME=chart

# ---- 调试（可选）----
# 流式调试日志：0=关闭（默认） 1=记录 TOKEN/TOOL 级事件 2=额外记录每 token 的 RAW_CHUNK
# DEBUG_STREAM=0
# 子 Agent 工具名严格校验（1=启动即报错，0=放行）
# SUBAGENT_TOOL_STRICT=1
# 沙箱出网策略（allowlist=白名单默认拒绝，open=全放开仅排障用）
# SANDBOX_EGRESS_MODE=allowlist
# 出网策略构造失败时的降级开关：默认 fail-closed（策略不可用则沙箱启动失败）。
# 仅本地排障、明确接受"沙箱可访问任意公网/内网"风险时才设为 1。
# SANDBOX_EGRESS_FAIL_OPEN=0
